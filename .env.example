# Copia este archivo como .env y cambia los valores. El archivo .env NO se sube a GitHub.

# Base de datos (la usa la aplicación y también docker-compose.yml)
DB_NAME=almibar
DB_USER=almibar
DB_PASSWORD=cambia-esta-clave
DB_ROOT_PASSWORD=cambia-esta-clave-de-root
DB_URL=jdbc:mysql://localhost:3306/almibar?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Bogota&characterEncoding=UTF-8

# Secreto para firmar los tokens: mínimo 32 bytes en Base64.
# Genera uno con:  openssl rand -base64 32
# o en PowerShell: [Convert]::ToBase64String([byte[]](1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
JWT_EXPIRACION_MINUTOS=60

# Imágenes: "local" guarda en la carpeta uploads/; "nube" usa Cloudinary
IMAGENES_PROVEEDOR=local
IMAGENES_DIRECTORIO=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
